  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "db:dev": "pglite-server --db=.local-db --port=5432 --host=127.0.0.1 --max-connections=10",
